# Maya Y-up. The four labeled swatches occupy the left panel;
# the strip on the right is a second material without a texture.
mtllib materials/plate.mtl
o Plate
v -1 0 -0.75
v -1 0 0.75
v 0.5 0 0.75
v 0.5 0 -0.75
v 1 0 0.75
v 1 0 -0.75
vn 0 1 0
vt 0 1
vt 0 0
vt 1 0
vt 1 1
usemtl Swatches
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
usemtl Border
f 4//1 3//1 5//1
f 4//1 5//1 6//1
